# Copy this file to secrets/mistral_api_key.txt and set your Mistral API key.
# WARNING: DO NOT COMMIT the real key file (mistral_api_key.txt) to version control.
# Add mistral_api_key.txt to .gitignore and set strict permissions (e.g., chmod 600) once created.
# This file is a template and is safe to check into version control.
#
# Example (preferred):
#   export MISTRAL_API_KEY=YOUR_MISTRAL_API_KEY_HERE
#
export MISTRAL_API_KEY=YOUR_MISTRAL_API_KEY_HERE
# Reminder: verify secrets/mistral_api_key.txt is in .gitignore before adding the real key.
