# RainRAG Environment Variables
# Copy this file to .env and configure for your environment
# WARNING: Never commit .env to version control!

# ============================================================================
# SECURITY - AUTHENTICATION (REQUIRED)
# ============================================================================

# Argon2 password hash for UI authentication (REQUIRED)
# Generate using: python scripts/generate_password_hash.py
# This is the PRIMARY authentication method
RAINRAG_PASSWORD_HASH=

# Session timeout in minutes (default: 480 = 8 hours)
# RAINRAG_SESSION_TIMEOUT=480

# Maximum failed login attempts before lockout (default: 5)
# RAINRAG_MAX_LOGIN_ATTEMPTS=5

# Account lockout duration in seconds (default: 300 = 5 minutes)
# RAINRAG_LOCKOUT_DURATION=300

# Enable audit logging for authentication events (default: true)
# RAINRAG_AUDIT_LOG=true

# Legacy authentication (DEPRECATED - use RAINRAG_PASSWORD_HASH instead)
# Only supported for backward compatibility
# STREAMLIT_AUTH_TOKEN=
# If set, browser media links include ?auth=<token> for /video and /vtt access.
# Keep this value aligned with backend RAINRAG_AUTH_TOKEN when API auth is enabled.

# ============================================================================
# LLM API KEYS
# ============================================================================

# Mistral API Key (required if using Mistral)
# Get your API key from https://console.mistral.ai/
MISTRAL_API_KEY=

# OpenAI API Key (required if using OpenAI)
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic API Key (required if using Claude)
# Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Google API Key (required if using Gemini)
# Get your API key from https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=

# Cohere API Key (required if using Cohere reranker)
# Get your API key from https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# ============================================================================
# LIBRARY METADATA API (for web metadata sync)
# ============================================================================

# Bearer token for library.tvrain.tv API
# Required for `rainrag sync-metadata` and web_metadata source=api/hybrid
LIBRARY_API_TOKEN=

# Base URL override (default: https://library.tvrain.tv)
# LIBRARY_API_URL=https://library.tvrain.tv

# ============================================================================
# API CONFIGURATION
# ============================================================================

# RainRAG API base URL (default: http://localhost:8001)
RAINRAG_API_URL=http://localhost:8001

# Optional browser-facing asset base URL for video/VTT links.
# Use this when UI can reach media at a different host/path than API_BASE.
# Example: if API is https://example.com/api but media is https://example.com,
# set RAINRAG_ASSET_URL=https://example.com
# RAINRAG_ASSET_URL=

# SSL verification for API requests (default: true)
# WARNING: Only disable for development with self-signed certificates
# Disabling SSL verification in production EXPOSES YOUR APPLICATION TO
# MAN-IN-THE-MIDDLE ATTACKS. Use proper certificates instead.
# RAINRAG_API_VERIFY=true

# Configuration file path (default: config.yaml)
RAINRAG_CONFIG=config.yaml

# Optional API host allowlist for FastAPI TrustedHostMiddleware.
# Comma-separated list; use exact hostnames (default includes rag.tvrain.tv + localhost).
# Example: RAINRAG_ALLOWED_HOSTS=rag.tvrain.tv,localhost,127.0.0.1
# RAINRAG_ALLOWED_HOSTS=

# Optional browser CORS origin allowlist for API.
# Comma-separated list of full origins including protocol.
# Example: RAINRAG_CORS_ORIGINS=https://rag.tvrain.tv,https://admin.rag.tvrain.tv
# RAINRAG_CORS_ORIGINS=

# Path to documents JSONL file for date range filtering
# RAINRAG_DOCS_PATH=./data/docs.jsonl

# ============================================================================
# CLOUDFLARE R2 (OPTIONAL)
# ============================================================================

# Cloudflare R2 (S3-compatible)
# Optional - Get your credentials from https://dash.cloudflare.com/
R2_ACCOUNT_ID=
R2_BUCKET=
# R2_PREFIX defaults to "embeddings" if not set (leave empty to use default)
R2_PREFIX=
# R2_PREFIX defaults to "embeddings"
R2_PREFIX=

# Optional Qdrant snapshot backup settings (used by scripts/backup_qdrant_r2.sh and scripts/restore_qdrant_r2.sh)
# R2_QDRANT_PREFIX defaults to "qdrant"
R2_QDRANT_PREFIX=
# QDRANT_URL defaults to http://localhost:6333
QDRANT_URL=
# QDRANT_COLLECTION defaults to "broadcast_transcripts"
QDRANT_COLLECTION=
# Optional: restore a specific snapshot file name from R2
QDRANT_SNAPSHOT_NAME=

# ============================================================================
# QUICK START GUIDE
# ============================================================================
#
# 1. GENERATE PASSWORD HASH (REQUIRED):
#    python scripts/generate_password_hash.py
#
#    This will prompt you to create a password and generate an Argon2 hash.
#    Copy the hash to RAINRAG_PASSWORD_HASH above.
#
# 2. SET API KEYS (if using external LLM providers):
#    - Add your Mistral/OpenAI/Claude/Gemini API keys above
#    - Only add keys for the providers you plan to use
#
# 3. CONFIGURE API ACCESS:
#    - Set RAINRAG_API_URL if your API is not at localhost:8001
#    - Adjust session timeout and login attempt limits if needed
#
# 4. START THE APPLICATION:
#    streamlit run app.py
#
# 5. LOGIN:
#    - Navigate to http://localhost:7860 in your browser
#    - Enter the password you created in step 1
#
# For detailed security documentation, see SECURITY.md
#
# SECURITY REMINDERS:
# - Never commit .env to version control
# - Use strong, unique passwords (12+ characters)
# - Rotate passwords regularly
# - Use different credentials for dev/staging/production
# - Deploy with HTTPS in production

# --- Telegram MTProto video import (optional) ---
# Only needed when video_upload.telegram_enabled is true in config.yaml.
# Get these from https://my.telegram.org, then run scripts/telegram_login.py
# once to create the session file. The API service reads this file via
# systemd EnvironmentFile, so shell exports alone will not reach it.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
