[Unit]
Description=RainRAG health check (quiet unless something is broken)
Documentation=file:///home/ubuntu/rainrag/deploy/systemd/HEALTH_CHECK.md
After=network.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/rainrag
# The script only reads config.yaml and stats data/telegram.session; it needs no
# secrets, so no EnvironmentFile here on purpose.
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/home/ubuntu/rainrag/.venv/bin/python3 /home/ubuntu/rainrag/scripts/health_check.py

# A healthy run exits 0 and prints nothing, so this unit leaves no journal entry
# at all. A problem exits 1, which marks the unit failed: `systemctl list-units
# --failed` shows it and `journalctl -u rainrag-health` has the report.
# Add an OnFailure= drop-in here if you want the failure mailed or pushed.

[Install]
WantedBy=multi-user.target
