[Unit]
Description=RainRAG Streamlit UI
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/rainrag
Environment=PATH=/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin
# Server-side call from the Streamlit process, so it goes straight to the
# API rather than out through the public name and back. The old value was
# rag.tvrain.tv, whose public path now returns 522.
Environment=RAINRAG_API_URL=http://127.0.0.1:8001
EnvironmentFile=-/home/ubuntu/rainrag/.env
ExecStart=/usr/bin/env bash -lc 'uv run streamlit run app.py --server.address 127.0.0.1 --server.port 7860 --server.headless true'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
